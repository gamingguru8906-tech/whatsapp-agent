{
  "name": "veshannastro-mobile-numerology",
  "version": "0.1.0",
  "private": true,
  "description": "Free rule-based mobile numerology reading (no AI at runtime).",
  "type": "module",
  "scripts": {
    "lint:rules": "node scripts/lint-rulebook.js",
    "lint:rules:strict": "node scripts/lint-rulebook.js --strict",
    "review": "node scripts/build-review.js",
    "audit": "node scripts/audit-sources.js",
    "build": "vite build",
    "dev": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "preview:build": "node scripts/build-preview.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neondatabase/serverless": "0.10.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "pg": "8.13.1",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "vite": "5.4.11",
    "wrangler": "4.135.0"
  }
}
