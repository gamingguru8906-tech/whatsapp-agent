# Set to gemini-3.8-flash or leave blank to use the application default.
GEMINI_MODEL=gemini-3.8-flash

# Payment links temporarily collect a real INR 1.00 gateway-validation charge.
# Remove this temporary override in index.js after the gateway test is complete.

# Configure these in Render's Secret Environment Variables, never commit values.
# GEMINI_API_KEY=
# WA_TOKEN=
# PHONE_NUMBER_ID=
# VERIFY_TOKEN=
# META_APP_SECRET=
# Use the Razorpay key pair you want to validate; an rzp_live_ key charges real money.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_APPS_SCRIPT_URL=
# Set the same random value in Render and Apps Script > Project Settings > Script Properties.
# GOOGLE_APPS_SCRIPT_SECRET=
# DATABASE_URL=
# ADMIN_PHONE_NUMBER=918827684725
# WA_FOLLOWUP_TEMPLATE=your_approved_general_followup_template
# WA_48H_DISCOUNT_TEMPLATE=your_approved_10_percent_offer_template
# The general follow-up template must have one body text variable (customer name).
# The 48-hour offer template must tell the opted-in customer to reply YES to accept.
# Both templates must be approved in Meta WhatsApp Manager for the selected language.
# WA_TEMPLATE_LANGUAGE=en

# ---- Phone Kamala (voice-agent.js) ----
# Exotel Voicebot applet URL: wss://<your-render-host>/voice/exotel?token=<VOICE_STREAM_TOKEN>
# VOICE_STREAM_TOKEN=a-long-random-string
# Live voice model and voice (defaults: gemini-3.8-live, then gemini-3.1-flash-live-preview; Aoede).
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_VOICE=Aoede
# Approved utility template for a caller who has never messaged you: header Document,
# body {{1}} name, {{2}} service, {{3}} date and time, {{4}} payment link.
# WA_CALL_PAYMENT_TEMPLATE=call_payment_link
# The number callers should send "Hi" to on WhatsApp when no template is approved yet.
# BUSINESS_WHATSAPP_NUMBER=+91 98xxxxxxxx
# VOICE_MAX_CONCURRENT_CALLS=10
# VOICE_MAX_CALL_MINUTES=15
# Indian voice for phone Kamala (Sarvam Bulbul). Without a key, Gemini's own voice is used.
# SARVAM_API_KEY=
# Female voices include simran, pooja, neha, kavya, ishita, shreya, ritu, tanya, shruti, suhani.
# SARVAM_SPEAKER=ritu
# SARVAM_LANGUAGE=hi-IN
# SARVAM_PACE=1.05
# EXOTEL_ACCOUNT_SID=veshannastro1

# ---- 2027 report paid on the website (web-orders.js) ----
# The same long random value in Render (here) and in Vercel. It signs the website's hand-off to /web-order.
# WEB_ORDER_SECRET=
# Approved utility template (Meta WhatsApp Manager), language WA_TEMPLATE_LANGUAGE:
#   header Document (the receipt); body {{1}} first name, {{2}} amount, {{3}} report, {{4}} invoice number.
# WA_R27_ORDER_TEMPLATE=r27_order_confirmed
# Optional thank-you photo or video after the confirmation: its own approved template with an image or video
# header and body {{1}} first name, plus a public https link to the photo or video.
# WA_R27_THANKS_TEMPLATE=
# WA_R27_THANKS_MEDIA_URL=
# WA_R27_THANKS_MEDIA_TYPE=image
# Razorpay > Webhooks: add the "order.paid" event to the existing /razorpay-webhook webhook.

# ---- The website's services and facts (site-services.js) ----
# Kamala reads <SITE_URL>/services.json every hour: every service with its price, the 2027 report offer, the report
# page's FAQ and the blog. Default https://www.veshannastro.co.in
# SITE_URL=

# ---- Report delivery: PDF, summary card, voice note and feedback (report-delivery.js) ----
# The same long random value here and on the report backend. It signs the backend's hand-off to /report-ready.
# REPORTS_SECRET=
# Approved utility templates (Meta WhatsApp Manager), language WA_TEMPLATE_LANGUAGE:
#   report_ready: header Document (the report PDF); body {{1}} first name, {{2}} report name.
#   report_feedback: body {{1}} first name, {{2}} report name, asking them to reply 1 to 5.
# WA_REPORT_READY_TEMPLATE=report_ready
# WA_REPORT_FEEDBACK_TEMPLATE=report_feedback
# The voice note uses Sarvam when SARVAM_API_KEY is set, else Gemini. REPORT_VOICE=gemini forces Gemini.
# REPORT_VOICE=
